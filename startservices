  <script>
    // Referring source name reveal (page-specific enhancement)
    (function () {
      var refSelect = document.getElementById('referring-source');
      var refNameGroup = document.getElementById('referring-name-group');
      var refNameInput = document.getElementById('referring-name');
      if (!refSelect || !refNameGroup || !refNameInput) return;
      refSelect.addEventListener('change', function () {
        var showName = this.options[this.selectedIndex].hasAttribute('data-show-name');
        refNameGroup.style.display = showName ? 'block' : 'none';
        refNameInput.required = showName;
        if (!showName) refNameInput.value = '';
      });
    })();

    // SSN auto-format (XXX-XX-XXXX)
    (function () {
      function formatSSN(input) {
        if (!input) return;
        input.addEventListener('input', function () {
          var v = this.value.replace(/\D/g, '').substring(0, 9);
          if (v.length > 5) v = v.slice(0, 3) + '-' + v.slice(3, 5) + '-' + v.slice(5);
          else if (v.length > 3) v = v.slice(0, 3) + '-' + v.slice(3);
          this.value = v;
        });
      }
      formatSSN(document.getElementById('child-ssn'));
      formatSSN(document.getElementById('adult-ssn'));
    })();

    // Active state styling for the type-card selector
    (function () {
      var radios = document.querySelectorAll('input[name="referral_type"]');
      radios.forEach(function (r) {
        r.addEventListener('change', function () {
          document.getElementById('type-child-label').classList.toggle('type-card--active', r.value === 'child' && r.checked);
          document.getElementById('type-adult-label').classList.toggle('type-card--active', r.value === 'adult' && r.checked);
        });
      });
    })();

    // Formspree submission for the referral form (delivers to the connected inbox)
    (function () {
      var form = document.querySelector('form[data-formspree-form]');
      if (!form) return;

      function setStatus(msg, kind) {
        var el = form.querySelector('[data-form-status]') || form.querySelector('.form-status');
        if (el) {
          el.textContent = msg;
          el.classList.remove('is-success', 'is-error');
          if (kind) el.classList.add('is-' + kind);
        }
        var ok = form.querySelector('.success-msg');
        if (ok && kind === 'success') {
          ok.classList.add('is-visible');
          ok.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      }

      form.addEventListener('submit', async function (e) {
        e.preventDefault();
        var submitBtn = form.querySelector('button[type="submit"]');
        var originalText = submitBtn ? submitBtn.innerHTML : '';
        if (submitBtn) { submitBtn.disabled = true; submitBtn.innerHTML = 'Sending\u2026'; }
        setStatus('Sending\u2026', null);

        // Point the reply-to field at whichever email was actually filled in
        var replyTo = document.getElementById('referral-replyto');
        var guardianEmail = document.getElementById('g-email');
        var adultEmail = document.getElementById('adult-email');
        if (replyTo) {
          if (guardianEmail && guardianEmail.value) replyTo.value = guardianEmail.value;
          else if (adultEmail && adultEmail.value) replyTo.value = adultEmail.value;
        }

        var formData = new FormData(form);

        try {
          var res = await fetch(form.action, {
            method: 'POST',
            headers: { 'Accept': 'application/json' },
            body: formData
          });
          if (res.ok) {
            form.reset();
            setStatus('Thank you. Your referral has been sent. We will be in touch within 1 to 2 business days.', 'success');
          } else {
            throw new Error('Submission failed');
          }
        } catch (err) {
          setStatus('Sorry, something went wrong. Please call (216) 971-1023 or email info@beloveitcare.com.', 'error');
        } finally {
          if (submitBtn) { submitBtn.disabled = false; submitBtn.innerHTML = originalText; }
        }
      });
    })();
  </script>

